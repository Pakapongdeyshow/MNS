# ==========================================
# MindNote Student (MNS) Environment Config
# ==========================================

# 1. JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 2. Server Port (for local development)
PORT=5000

# 3. Google OAuth 2.0 Credentials (Optional / Recommended)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Add Authorized JavaScript Origins: https://your-project.vercel.app, http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
